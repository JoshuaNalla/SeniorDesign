@page "/"
@using SeniorDesign.ImageProcessing;
@using Emgu.CV;

<h1>Hello, world!</h1>

Welcome to your new app.

<button class="btn btn-primary" @onclick="DoImageProcessing">Do Image Processing</button>
<label>@velocity</label>

@code{
    private double velocity = 0.0;

    private void DoImageProcessing()
    {
        using (VideoCapture capture = new(@"C:\Users\mitch\source\repos\SeniorDesign\DataAndDebug\videoplayback2.mp4"))
        {
            IImageProcessor processor = new ImageProcessor();
            velocity = processor.GetBallSpeed(capture);
        }
    }
}