@using System.Text.RegularExpressions

<input 
    type="text"
    inputmode="numeric"
    pattern="[0-9]*"
    title="Please enter an integer number."
    oninput="this.value = this.value.replace(/[^0-9]/g, '')" 
    @bind="Text"
/>

@code {
    public string Text { get; set; }
    public int Number { 
        get
        {
            int.TryParse(Text, out int value);
            return value;
        }
        set
        {
            Text = value.ToString();
            field = value;
        }
    }
}
