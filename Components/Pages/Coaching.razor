@page "/coaching"

<div class="coaching-container">
    <div class="coaching-grid">
        <div class="coaching-box camera"></div>
        <div class="coaching-box sensor-placement"></div>

        <div class="coaching-box mid-1"></div>
        <div class="coaching-box mid-2"></div>
        <div class="coaching-box mid-3"></div>
        <div class="coaching-box mid-4"></div>
        <div class="coaching-box mid-5"></div>
        <div class="coaching-box mid-6"></div>
        <div class="coaching-box session"></div>
        <div class="coaching-box session-actions"></div>
    </div>
</div>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
